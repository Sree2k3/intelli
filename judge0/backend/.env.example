# Backend Environment Variables
# Copy this to .env and fill in your values

# Database (required)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/intellihire

# JWT (required - generate a secure random string)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# LLM Provider - Choose ONE:
# Option A: Groq (recommended - free tier available)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Option B: Ollama (local, no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Option C: OpenAI (fallback)
# OPENAI_API_KEY=sk-your_openai_key_here

# Voice / TTS Pipeline
DEEPGRAM_API_KEY=your_deepgram_key_here
DEEPGRAM_TTS_MODEL=aura-asteria-en
TTS_PROVIDER=deepgram

# Judge0 (code execution) - Self-hosted sandboxed executor
JUDGE0_URL=http://judge0:2358
JUDGE0_AUTH_TOKEN=

# Piston (fallback code execution)
PISTON_URL=https://emkc.org/api/v2/piston

# CORS
FRONTEND_ORIGIN=http://localhost:8080
CORS_ORIGIN_REGEX=

# Integration URLs
XEVHIRE_BASE_URL=http://localhost:8080
AI_INTERVIEW_BASE_URL=http://localhost:8080
RESULTS_BASE_URL=http://localhost:8080
WEBHOOK_CALLBACK_URL=http://localhost:8080/api/webhook

# AWS S3 (optional - for video recordings)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
STORAGE_MODE=local

# Email/SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Encryption (optional)
ENCRYPTION_KEY=
REQUIRE_ENCRYPTION=false

# ATS Integration
ATS_API_KEY=test_ats_secret_token
AI_WEBHOOK_SECRET=test_ai_webhook_secret